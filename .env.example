# Gemini API key (server-side secret).
# Set this in Cloudflare Pages: Settings > Variables and Secrets > Add > Secret.
# Locally, put it in .env.local (never commit it).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: public URL where this applet is hosted (e.g. https://bone-breaker.pages.dev).
APP_URL="MY_APP_URL"
